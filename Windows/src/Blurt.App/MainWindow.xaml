<Window x:Class="Blurt.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blurt"
        Width="420"
        Height="240"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="24" VerticalAlignment="Center">
    <TextBlock x:Name="ProductName" FontSize="24" FontWeight="SemiBold" Text="Blurt" />
    <TextBlock Margin="0,12,0,0" FontSize="14">
      <Run Text="Dictation: " />
      <Run Text="{Binding Phase, Mode=OneWay}" />
    </TextBlock>
    <Button Margin="0,20,0,0" Padding="16,4" HorizontalAlignment="Left" Content="Settings" />
  </StackPanel>
</Window>
