<UserControl x:Class="Blurt.App.Settings.AdvancedTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:Blurt.App.Settings"
             xmlns:svc="clr-namespace:Blurt.App.Services">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">
      <TextBlock Style="{StaticResource SectionHeader}" Text="Transcription" />
      <Border Style="{StaticResource Card}">
        <CheckBox Content="Enhanced transcripts" IsChecked="{Binding Styles.EnhancedTranscripts, Mode=TwoWay}" />
      </Border>
      <TextBlock Style="{StaticResource Footer}"
                 Margin="0,-8,0,20"
                 Text="Polishes each dictation before pasting — removing filler words and fixing punctuation. Turn off to paste your words exactly as spoken." />

      <StackPanel IsEnabled="{Binding Styles.EnhancedTranscripts, Mode=OneWay}">
        <TextBlock Style="{StaticResource SectionHeader}" Text="Custom Styles" />
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding Styles.Profiles, Mode=OneWay}" AutomationProperties.Name="Custom styles">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Name, Mode=OneWay}" />
                    <Button DockPanel.Dock="Right"
                            Padding="10,2"
                            Content="Edit…"
                            Tag="{Binding}"
                            Click="OnEditStyleClick" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button HorizontalAlignment="Left"
                    Padding="10,2"
                    Content="Add Style…"
                    IsEnabled="{Binding Styles.CanAdd, Mode=OneWay}"
                    Click="OnAddStyleClick" />
          </StackPanel>
        </Border>
      </StackPanel>
      <TextBlock Style="{StaticResource Footer}" Margin="0,-8,0,20" Text="{Binding Styles.StylesFooter, Mode=OneWay}" />

      <TextBlock Style="{StaticResource SectionHeader}" Text="Updates" />
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource RowLabel}" Text="{Binding Updates.VersionLabel, Mode=OneTime}" />
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource PlainButton}"
                    Content="Check for Updates"
                    IsEnabled="{Binding Updates.IsChecking, Mode=OneWay, Converter={x:Static svc:Inverted.Instance}}"
                    Click="OnCheckForUpdatesClick" />
            <ProgressBar DockPanel.Dock="Right"
                         Width="60"
                         Height="6"
                         Margin="0,0,12,0"
                         IsIndeterminate="True"
                         Visibility="{Binding Updates.IsChecking, Mode=OneWay, Converter={StaticResource Visible}}" />
          </DockPanel>
          <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Secondary}" Text="{Binding LastCheckedCaption, Mode=OneWay}" />
        </StackPanel>
      </Border>

      <settings:ExperimentalSection Margin="0,4,0,4" />
      <settings:DeveloperSection Margin="0,4,0,4" />
      <settings:ResetSection x:Name="Reset" Margin="0,4,0,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
