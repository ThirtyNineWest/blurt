<UserControl x:Class="Blurt.App.Settings.ExperimentalSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding Experimental}">
  <StackPanel>
    <TextBlock Style="{StaticResource SectionHeader}" Text="Experimental" />
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <CheckBox Content="Read selected text aloud" IsChecked="{Binding ReadAloud, Mode=TwoWay}" />
        <StackPanel Visibility="{Binding ShowsReadOptions, Mode=OneWay, Converter={StaticResource Visible}}">
          <CheckBox Margin="0,10,0,0" Content="Hold to ask about the selection" IsChecked="{Binding Ask, Mode=TwoWay}" />
          <DockPanel Margin="0,10,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource RowLabel}" Text="Speed" />
            <ComboBox DockPanel.Dock="Right"
                      MinWidth="90"
                      ItemsSource="{Binding SpeedChoices, Mode=OneTime}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding Speed, Mode=TwoWay}"
                      AutomationProperties.Name="Read-aloud speed" />
          </DockPanel>
          <CheckBox Margin="0,10,0,0" Content="Skip code, links, and long numbers" IsChecked="{Binding SkipsJargon, Mode=TwoWay}" />
        </StackPanel>
      </StackPanel>
    </Border>
    <TextBlock Style="{StaticResource Footer}" Margin="0,-8,0,0" Text="{Binding HowToUse, Mode=OneWay}" />
    <TextBlock Style="{StaticResource Footer}"
               Text="{Binding AskNote, Mode=OneWay}"
               Visibility="{Binding ShowsAskNote, Mode=OneWay, Converter={StaticResource Visible}}" />
    <TextBlock Style="{StaticResource Footer}"
               Text="{Binding SkipNote, Mode=OneTime}"
               Visibility="{Binding ShowsSkipNote, Mode=OneWay, Converter={StaticResource Visible}}" />
  </StackPanel>
</UserControl>
