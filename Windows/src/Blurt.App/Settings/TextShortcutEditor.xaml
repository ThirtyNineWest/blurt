<Window x:Class="Blurt.App.Settings.TextShortcutEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Text Shortcut"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20">
    <TextBlock FontSize="15" FontWeight="SemiBold" Text="Text Shortcut" />
    <TextBlock Margin="0,6,0,16"
               TextWrapping="Wrap"
               Foreground="{StaticResource Secondary}"
               Text="When you say the phrase, Blurt pastes the replacement instead." />

    <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Phrase" />
    <TextBox x:Name="PhraseField" Padding="4,3" AutomationProperties.Name="Phrase" TextChanged="OnFieldChanged" />
    <TextBlock x:Name="DuplicateWarning"
               Margin="0,4,0,0"
               FontSize="11"
               Foreground="{StaticResource ErrorText}"
               Text="Another shortcut already uses this phrase." />

    <TextBlock Margin="0,16,0,6" FontWeight="SemiBold" Text="Replacement" />
    <TextBox x:Name="ReplacementField"
             Padding="4,3"
             MinLines="1"
             MaxLines="6"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             AutomationProperties.Name="Replacement"
             TextChanged="OnReplacementChanged" />

    <DockPanel Margin="0,16,0,0" LastChildFill="False">
      <Button x:Name="DeleteButton"
              DockPanel.Dock="Left"
              Style="{StaticResource PlainButton}"
              Foreground="{StaticResource ErrorText}"
              Content="Delete"
              Click="OnDeleteClick" />
      <Button x:Name="SaveButton"
              DockPanel.Dock="Right"
              Style="{StaticResource PrimaryButton}"
              IsDefault="True"
              Content="Save"
              Click="OnSaveClick" />
      <Button DockPanel.Dock="Right"
              Margin="0,0,12,0"
              Style="{StaticResource PlainButton}"
              IsCancel="True"
              Content="Cancel" />
    </DockPanel>
  </StackPanel>
</Window>
