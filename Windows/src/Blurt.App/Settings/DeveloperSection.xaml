<UserControl x:Class="Blurt.App.Settings.DeveloperSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Style="{StaticResource SectionHeader}" Text="Developer" />
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <CheckBox Content="Developer mode" IsChecked="{Binding DeveloperMode, Mode=TwoWay}" />

        <TextBlock Margin="0,12,0,4" Foreground="{StaticResource Secondary}" Text="Logs each dictation to" />
        <DockPanel>
          <Button DockPanel.Dock="Right"
                  Margin="8,0,0,0"
                  Padding="10,2"
                  Content="Copy path"
                  AutomationProperties.Name="Copy dictation log path"
                  Tag="{Binding DictationsPath, Mode=OneTime}"
                  Click="OnCopyPathClick" />
          <TextBox IsReadOnly="True" Text="{Binding DictationsPath, Mode=OneTime}" AutomationProperties.Name="Dictation log path" />
        </DockPanel>

        <TextBlock Margin="0,10,0,4" Foreground="{StaticResource Secondary}" Text="and each failure to" />
        <DockPanel>
          <Button DockPanel.Dock="Right"
                  Margin="8,0,0,0"
                  Padding="10,2"
                  Content="Copy path"
                  AutomationProperties.Name="Copy error log path"
                  Tag="{Binding ErrorsPath, Mode=OneTime}"
                  Click="OnCopyPathClick" />
          <TextBox IsReadOnly="True" Text="{Binding ErrorsPath, Mode=OneTime}" AutomationProperties.Name="Error log path" />
        </DockPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
