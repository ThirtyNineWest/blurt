<Window x:Class="Blurt.App.Settings.StyleProfileEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Style"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20">
    <TextBlock FontSize="15" FontWeight="SemiBold" Text="Custom Style" />
    <TextBlock Margin="0,6,0,16"
               TextWrapping="Wrap"
               Foreground="{StaticResource Secondary}"
               Text="Applied while polishing each dictation — casing, tone, emoji use." />

    <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Name" />
    <TextBox x:Name="NameField" Padding="4,3" AutomationProperties.Name="Style name" TextChanged="OnNameChanged" />

    <TextBlock Margin="0,16,0,6" FontWeight="SemiBold" Text="Instructions" />
    <TextBox x:Name="InstructionsField"
             Padding="4,3"
             MinLines="3"
             MaxLines="6"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             AutomationProperties.Name="Instructions"
             TextChanged="OnInstructionsChanged" />
    <TextBlock x:Name="Counter"
               Margin="0,4,0,0"
               HorizontalAlignment="Right"
               FontSize="11"
               Foreground="{StaticResource Secondary}" />

    <DockPanel Margin="0,16,0,0" LastChildFill="False">
      <Button x:Name="DeleteButton"
              DockPanel.Dock="Left"
              Style="{StaticResource PlainButton}"
              Foreground="{StaticResource ErrorText}"
              Content="Delete"
              Click="OnDeleteClick" />
      <Button x:Name="SaveButton"
              DockPanel.Dock="Right"
              Style="{StaticResource PrimaryButton}"
              IsDefault="True"
              Content="Save"
              Click="OnSaveClick" />
      <Button DockPanel.Dock="Right"
              Margin="0,0,12,0"
              Style="{StaticResource PlainButton}"
              IsCancel="True"
              Content="Cancel" />
    </DockPanel>
  </StackPanel>
</Window>
