<UserControl x:Class="Blurt.App.Settings.GeneralTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:steps="clr-namespace:Blurt.App.Main.Steps">
  <StackPanel Margin="20">
    <StackPanel Margin="0,0,0,20">
      <TextBlock Style="{StaticResource SectionHeader}" Text="AssemblyAI" />
      <Border Style="{StaticResource Card}">
        <DockPanel LastChildFill="False">
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource RowLabel}" Text="API Key" />
          <Button DockPanel.Dock="Right"
                  Style="{StaticResource PrimaryButton}"
                  Content="{Binding KeyDisplay.EditButtonTitle, Mode=OneWay}"
                  Click="OnEditKeyClick" />
          <TextBlock DockPanel.Dock="Right"
                     Margin="0,0,12,0"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource Secondary}"
                     Text="{Binding KeyDisplay.StatusText, Mode=OneWay}"
                     AutomationProperties.Name="{Binding KeyDisplay.AccessibilityLabel, Mode=OneWay}" />
        </DockPanel>
      </Border>
      <TextBlock Style="{StaticResource Footer}" Text="Blurt sends your audio to AssemblyAI to transcribe it." />
    </StackPanel>

    <StackPanel DataContext="{Binding Dictation}">
      <steps:ShortcutStep Margin="0,0,0,20" />
      <steps:SoundStep />
    </StackPanel>
  </StackPanel>
</UserControl>
