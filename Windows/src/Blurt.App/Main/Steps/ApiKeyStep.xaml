<UserControl x:Class="Blurt.App.Main.Steps.ApiKeyStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Blurt.App.Services">
  <StackPanel>
    <TextBlock Style="{StaticResource SectionHeader}" Text="AssemblyAI" />
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <DockPanel LastChildFill="False">
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource RowLabel}" Text="API Key" />
          <TextBlock DockPanel.Dock="Right"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource Secondary}"
                     Text="{Binding KeyDisplay.StatusText, Mode=OneWay}"
                     AutomationProperties.Name="{Binding KeyDisplay.AccessibilityLabel, Mode=OneWay}" />
        </DockPanel>

        <TextBlock Margin="0,12,0,6" TextWrapping="Wrap" Text="{Binding KeyDisplay.Rationale, Mode=OneWay}" />
        <PasswordBox x:Name="KeyField"
                     Padding="4,3"
                     AutomationProperties.Name="API Key"
                     PasswordChanged="OnPasswordChanged" />

        <TextBlock Margin="0,6,0,0"
                   Foreground="{StaticResource ErrorText}"
                   TextWrapping="Wrap"
                   Text="{Binding InlineError, Mode=OneWay}"
                   Visibility="{Binding InlineError, Mode=OneWay, Converter={x:Static svc:NullToCollapsed.Instance}}" />
        <TextBlock Margin="0,6,0,0"
                   Foreground="{StaticResource Secondary}"
                   TextWrapping="Wrap"
                   Text="Your key is stored in Windows Credential Manager." />

        <DockPanel Margin="0,12,0,0" LastChildFill="False">
          <TextBlock DockPanel.Dock="Left"
                     VerticalAlignment="Center"
                     Visibility="{Binding KeyDisplay.IsConnected, Mode=OneWay, Converter={x:Static svc:TrueToCollapsed.Instance}}">
            <Hyperlink Click="OnGetKeyClick">Get an API key</Hyperlink>
          </TextBlock>
          <Button DockPanel.Dock="Right"
                  Style="{StaticResource PrimaryButton}"
                  IsDefault="True"
                  Content="{Binding KeyDisplay.CommitButtonTitle, Mode=OneWay}"
                  IsEnabled="{Binding CanSubmit, Mode=OneWay}"
                  Click="OnSubmitClick" />
          <ProgressBar DockPanel.Dock="Right"
                       Width="60"
                       Height="6"
                       Margin="0,0,12,0"
                       IsIndeterminate="True"
                       Visibility="{Binding IsSubmitting, Mode=OneWay, Converter={StaticResource Visible}}" />
        </DockPanel>
      </StackPanel>
    </Border>
    <TextBlock Style="{StaticResource Footer}" Text="Blurt sends your audio to AssemblyAI to transcribe it." />
  </StackPanel>
</UserControl>
