<UserControl x:Class="Blurt.App.Main.StyleSwitcher"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Margin="0,0,0,8" Foreground="{StaticResource Secondary}" Text="How Blurt cleans up your raw transcript" />
    <Border Style="{StaticResource Card}" Padding="12,9">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Style="{StaticResource RowLabel}" Text="Output Styles:" />
        <Button DockPanel.Dock="Right"
                Padding="8,2"
                VerticalAlignment="Center"
                Content="Edit Styles…"
                Click="OnEditStylesClick" />
        <ItemsControl ItemsSource="{Binding Styles.Choices, Mode=OneWay}"
                      IsEnabled="{Binding CanSwitchStyle, Mode=OneWay}"
                      AutomationProperties.Name="Output style">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <!-- No GroupName: a shared group unchecks siblings before this button writes its source, which can
                   revert the click. Exclusivity comes from StyleChoices re-marking every entry. -->
              <RadioButton Margin="0,2,6,2"
                           Padding="10,3"
                           Style="{StaticResource {x:Type ToggleButton}}"
                           Content="{Binding Name, Mode=OneWay}"
                           IsChecked="{Binding IsActive, Mode=TwoWay}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>
  </StackPanel>
</UserControl>
