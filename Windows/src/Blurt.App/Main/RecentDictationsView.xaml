<UserControl x:Class="Blurt.App.Main.RecentDictationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:main="clr-namespace:Blurt.App.Main"
             xmlns:svc="clr-namespace:Blurt.App.Services">
  <StackPanel>
    <TextBlock Margin="0,0,0,8" Foreground="{StaticResource Secondary}" Text="Recent" />
    <Border Style="{StaticResource Card}"
            Padding="0"
            BorderThickness="1">
      <Grid Height="{Binding Source={x:Static main:ReadyViewModel.RecentHeight}}">
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource Secondary}"
                   Text="Your recent blurts will appear here"
                   Visibility="{Binding HasRecent, Mode=OneWay, Converter={x:Static svc:TrueToCollapsed.Instance}}" />
        <ItemsControl ItemsSource="{Binding Recent, Mode=OneWay}"
                      VerticalAlignment="Top"
                      AutomationProperties.Name="Recent dictations">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <Border x:Name="Row"
                        Height="{Binding Source={x:Static main:ReadyViewModel.RowHeight}}"
                        Background="Transparent"
                        Cursor="Hand"
                        ToolTip="{Binding Text, Mode=OneWay}"
                        MouseLeftButtonUp="OnRowClicked">
                  <DockPanel Margin="12,0">
                    <Grid DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center">
                      <StackPanel x:Name="StyleAndTime"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  IsHitTestVisible="False">
                        <Border Margin="0,0,8,0"
                                Padding="6,0"
                                VerticalAlignment="Center"
                                CornerRadius="7"
                                Background="{StaticResource CardBorder}"
                                Visibility="{Binding Style, Mode=OneWay, Converter={x:Static svc:NullToCollapsed.Instance}}">
                          <TextBlock FontSize="11" Text="{Binding Style, Mode=OneWay}" />
                        </Border>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{StaticResource Secondary}"
                                   Text="{Binding RelativeLabel, Mode=OneWay}" />
                      </StackPanel>
                      <Button x:Name="CopyButton"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Padding="6,0"
                              FontSize="11"
                              Content="Copy"
                              IsTabStop="True"
                              Opacity="0"
                              IsHitTestVisible="False"
                              AutomationProperties.Name="Copy dictation"
                              Click="OnCopyClicked" />
                      <TextBlock x:Name="CopyFeedback"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center"
                                 FontSize="11"
                                 Foreground="{StaticResource Secondary}"
                                 Opacity="0"
                                 IsHitTestVisible="False"
                                 AutomationProperties.LiveSetting="Polite"
                                 Text="{Binding CopyFeedbackLabel, Mode=OneWay}" />
                    </Grid>
                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Text, Mode=OneWay}" />
                  </DockPanel>
                </Border>
                <Rectangle Height="{Binding Source={x:Static main:ReadyViewModel.SeparatorThickness}}"
                           Fill="{StaticResource CardBorder}"
                           Visibility="{Binding ShowsSeparator, Mode=OneWay, Converter={StaticResource Visible}}" />
              </StackPanel>
              <!-- The Copy button is faded, never collapsed, so it keeps keyboard focus while the
                   acknowledgement shows. Later triggers win: the acknowledgement overrides hover and focus. -->
              <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                  <Setter TargetName="StyleAndTime" Property="Opacity" Value="0" />
                  <Setter TargetName="CopyButton" Property="Opacity" Value="1" />
                  <Setter TargetName="CopyButton" Property="IsHitTestVisible" Value="True" />
                </Trigger>
                <Trigger SourceName="CopyButton" Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="StyleAndTime" Property="Opacity" Value="0" />
                  <Setter TargetName="CopyButton" Property="Opacity" Value="1" />
                  <Setter TargetName="CopyButton" Property="IsHitTestVisible" Value="True" />
                </Trigger>
                <DataTrigger Binding="{Binding ShowsCopyFeedback, Mode=OneWay}" Value="True">
                  <Setter TargetName="StyleAndTime" Property="Opacity" Value="0" />
                  <Setter TargetName="CopyButton" Property="Opacity" Value="0" />
                  <Setter TargetName="CopyButton" Property="IsHitTestVisible" Value="False" />
                  <Setter TargetName="CopyFeedback" Property="Opacity" Value="1" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
