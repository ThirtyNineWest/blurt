<UserControl x:Class="Blurt.App.Main.RecentDictationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:main="clr-namespace:Blurt.App.Main"
             xmlns:svc="clr-namespace:Blurt.App.Services">
  <StackPanel>
    <TextBlock Margin="0,0,0,8" Foreground="{StaticResource Secondary}" Text="Recent" />
    <Border Style="{StaticResource Card}"
            Padding="0"
            BorderThickness="1">
      <Grid Height="{Binding Source={x:Static main:ReadyViewModel.RecentHeight}}">
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource Secondary}"
                   Text="Your recent blurts will appear here"
                   Visibility="{Binding HasRecent, Mode=OneWay, Converter={x:Static svc:TrueToCollapsed.Instance}}" />
        <ItemsControl ItemsSource="{Binding Recent, Mode=OneWay}"
                      VerticalAlignment="Top"
                      AutomationProperties.Name="Recent dictations">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <DockPanel Height="{Binding Source={x:Static main:ReadyViewModel.RowHeight}}"
                           Margin="12,0"
                           ToolTip="{Binding Text, Mode=OneWay}">
                  <TextBlock DockPanel.Dock="Right"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0"
                             FontSize="11"
                             Foreground="{StaticResource Secondary}"
                             Text="{Binding RelativeLabel, Mode=OneWay}" />
                  <Border DockPanel.Dock="Right"
                          Margin="8,0,0,0"
                          Padding="6,0"
                          VerticalAlignment="Center"
                          CornerRadius="7"
                          Background="{StaticResource CardBorder}"
                          Visibility="{Binding Style, Mode=OneWay, Converter={x:Static svc:NullToCollapsed.Instance}}">
                    <TextBlock FontSize="11" Text="{Binding Style, Mode=OneWay}" />
                  </Border>
                  <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Text, Mode=OneWay}" />
                </DockPanel>
                <Rectangle Height="{Binding Source={x:Static main:ReadyViewModel.SeparatorThickness}}"
                           Fill="{StaticResource CardBorder}"
                           Visibility="{Binding ShowsSeparator, Mode=OneWay, Converter={StaticResource Visible}}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
